# Copy to .env and adjust. Не коммитить .env в репозиторий.

# --- Локальная разработка (make run) ---
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (для docker-compose и для локального запуска)
POSTGRES_USER=payoutflow
POSTGRES_PASSWORD=set-secure-password-here
POSTGRES_DB=payoutflow
# Для запуска вне Docker (make run) используйте тот же пароль в DATABASE_URL:
DATABASE_URL=postgres://payoutflow:set-secure-password-here@localhost:5432/payoutflow

# Redis (Celery broker and result backend)
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Production (на сервере или в Docker для прода) ---
# DEBUG=False
# SECRET_KEY=сгенерировать-уникальный-секрет-не-использовать-дефолт
# ALLOWED_HOSTS=api.example.com,your-server-ip
# DATABASE_URL=postgres://user:password@host:5432/dbname
# CELERY_BROKER_URL=redis://redis-host:6379/0
# При развёртывании за прокси с HTTPS можно задать:
# SECURE_SSL_REDIRECT=True (уже в config.settings.production)
